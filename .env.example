# Copy to .env for Docker Compose, and to apps/api/.env for the API.
# Local Docker PostgreSQL values; change passwords outside local development.
POSTGRES_USER=ticketforge
POSTGRES_PASSWORD=ticketforge_local_only
POSTGRES_DB=ticketforge
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092

# API: use DATABASE_URL for local PostgreSQL or Supabase's direct/session-pooler URL.
# Never prefix database secrets with NEXT_PUBLIC_ or put them in apps/web/.env.local.
DATABASE_URL=postgresql://ticketforge:ticketforge_local_only@localhost:5432/ticketforge
# Optional Prisma CLI connection for hosted databases; omit for local Docker.
# DIRECT_URL=postgresql://user:password@direct-host:5432/database
# Set DB_SSL=true for Supabase (verify TLS certificates); default false for local Docker.
DB_SSL=false
DB_POOL_MAX=10
API_HOST=127.0.0.1
API_PORT=3001

# Web: server-side only; use a reachable API host from the Next.js server.
API_INTERNAL_URL=http://127.0.0.1:3001
