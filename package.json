{
  "name": "ticketforge",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @ticketforge/api\" \"npm run dev -w @ticketforge/web\"",
    "build": "npm run build -w @ticketforge/api -w @ticketforge/web",
    "typecheck": "npm run typecheck -w @ticketforge/api -w @ticketforge/web",
    "test": "npm run test -w @ticketforge/api -w @ticketforge/web",
    "test:db": "npm run test:db -w @ticketforge/api",
    "lint": "npm run lint -w @ticketforge/api -w @ticketforge/web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
