{
  "name": "ticketforge",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @ticketforge/api --filter @ticketforge/web dev",
    "build": "corepack pnpm --recursive --filter @ticketforge/api --filter @ticketforge/web build",
    "typecheck": "corepack pnpm --recursive --filter @ticketforge/api --filter @ticketforge/web typecheck",
    "test": "corepack pnpm --recursive --filter @ticketforge/api --filter @ticketforge/web test",
    "test:db": "corepack pnpm --filter @ticketforge/api test:db",
    "lint": "corepack pnpm --recursive --filter @ticketforge/api --filter @ticketforge/web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
