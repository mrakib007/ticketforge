{
  "name": "@ticketforge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file=.env --import tsx src/db/seed-events.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude test/postgres.integration.test.ts",
    "test:db": "vitest run test/postgres.integration.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@ticketforge/contracts": "0.1.0",
    "fastify": "5.7.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testcontainers/postgresql": "11.7.2",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.4"
  }
}
