generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ATTENDEE
  ORGANIZER
}

model Event {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String
  venue       String
  startsAt    DateTime @db.Timestamptz(3)
  endsAt      DateTime @db.Timestamptz(3)
  published   Boolean  @default(false)
  capacity    Int      @default(0)
  bookedSeats Int      @default(0)
  bookings    Booking[]
  organizerId String?  @db.Uuid
  organizer   User?     @relation("OrganizedEvents", fields: [organizerId], references: [id], onDelete: Restrict)

  @@index([published, startsAt])
  @@index([organizerId, startsAt])
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  sessions     Session[]
  bookings     Booking[]
  role         UserRole  @default(ATTENDEE)
  organizedEvents Event[] @relation("OrganizedEvents")
  cinemaBookings CinemaBooking[]
  cinemaHolds CinemaHold[]
}

model Session {
  tokenHash String   @id @db.VarChar(64)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model Booking {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  eventId   String   @db.Uuid
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  idempotencyKey String? @db.Uuid
  cancelledAt DateTime? @db.Timestamptz(3)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([eventId])
}

enum ScreeningStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Cinema {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  description String
  address     String
  timeZone    String
  imageUrl    String?
  isDemo      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  auditoriums Auditorium[]
}

model Movie {
  id              String      @id @default(uuid()) @db.Uuid
  title           String
  synopsis        String
  durationMinutes Int
  posterUrl       String?
  releaseDate     DateTime?   @db.Date
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  screenings      Screening[]
}

model Auditorium {
  id         String      @id @default(uuid()) @db.Uuid
  cinemaId   String      @db.Uuid
  cinema     Cinema      @relation(fields: [cinemaId], references: [id], onDelete: Restrict)
  name       String
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  seats      Seat[]
  screenings Screening[]

  @@unique([cinemaId, name])
}

model Seat {
  id           String     @id @default(uuid()) @db.Uuid
  auditoriumId String     @db.Uuid
  auditorium   Auditorium @relation(fields: [auditoriumId], references: [id], onDelete: Restrict)
  rowLabel     String
  seatNumber   Int
  category     String     @default("STANDARD")
  isActive     Boolean    @default(true)
  reservations CinemaBookingSeat[]
  holdSeats CinemaHoldSeat[]

  @@unique([auditoriumId, rowLabel, seatNumber])
}

model Screening {
  id               String          @id @default(uuid()) @db.Uuid
  movieId          String          @db.Uuid
  movie            Movie           @relation(fields: [movieId], references: [id], onDelete: Restrict)
  auditoriumId     String          @db.Uuid
  auditorium       Auditorium      @relation(fields: [auditoriumId], references: [id], onDelete: Restrict)
  startsAt         DateTime        @db.Timestamptz(3)
  endsAt           DateTime        @db.Timestamptz(3)
  bookingClosesAt  DateTime        @db.Timestamptz(3)
  priceMinor       Int
  currency         String          @db.VarChar(3)
  status           ScreeningStatus @default(DRAFT)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  bookings         CinemaBooking[]
  reservations     CinemaBookingSeat[]
  holds            CinemaHold[]
  holdSeats        CinemaHoldSeat[]

  @@index([auditoriumId, startsAt])
  @@index([status, startsAt])
}

model CinemaBooking {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  screeningId    String   @db.Uuid
  screening      Screening @relation(fields: [screeningId], references: [id], onDelete: Restrict)
  idempotencyKey String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  seats          CinemaBookingSeat[]

  @@unique([userId, idempotencyKey])
  @@unique([id, userId, screeningId])
  @@index([userId, screeningId])
}

model CinemaBookingSeat {
  bookingId   String @db.Uuid
  userId      String @db.Uuid
  screeningId String @db.Uuid
  seatId      String @db.Uuid
  booking     CinemaBooking @relation(fields: [bookingId, userId, screeningId], references: [id, userId, screeningId], onDelete: Restrict)
  screening   Screening @relation(fields: [screeningId], references: [id], onDelete: Restrict)
  seat        Seat @relation(fields: [seatId], references: [id], onDelete: Restrict)

  @@id([bookingId, seatId])
  @@unique([screeningId, seatId])
  @@index([userId, screeningId])
}

enum CinemaHoldStatus {
  HOLDING
  EXPIRED
  PAYMENT_FAILED
  CONFIRMED
  PAID_UNFULFILLED
}

model CinemaHold {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @db.Uuid
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)
  screeningId    String @db.Uuid
  screening      Screening @relation(fields: [screeningId], references: [id], onDelete: Restrict)
  idempotencyKey String @db.Uuid
  status         CinemaHoldStatus @default(HOLDING)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)
  totalMinor     Int
  currency       String @db.VarChar(3)
  seats          CinemaHoldSeat[]

  @@unique([userId, idempotencyKey])
  @@unique([id, userId, screeningId])
  @@index([userId, screeningId])
  @@index([status, expiresAt])
}

// Immutable selection and price snapshot: expired holds retain their history.
model CinemaHoldSeat {
  holdId      String @db.Uuid
  userId      String @db.Uuid
  screeningId String @db.Uuid
  seatId      String @db.Uuid
  priceMinor  Int
  hold        CinemaHold @relation(fields: [holdId, userId, screeningId], references: [id, userId, screeningId], onDelete: Restrict)
  screening   Screening @relation(fields: [screeningId], references: [id], onDelete: Restrict)
  seat        Seat @relation(fields: [seatId], references: [id], onDelete: Restrict)

  @@id([holdId, seatId])
  @@index([screeningId, seatId])
  @@index([userId, screeningId])
}
